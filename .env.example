#this is example .env file , never expose secret keys here

# ---------------------------------------------------------------------------
# Vita Mojo (VM Hub) credentials
# ---------------------------------------------------------------------------
VM_HUB_URL=https://hub.vitamojo.com
VM_HUB_EMAIL=
VM_HUB_PASSWORD=

# ---------------------------------------------------------------------------
# Supabase (VM Analytics project)
# ---------------------------------------------------------------------------
SUPABASE_PROJECT_URL=
# Publishable/anon key is READ-ONLY and is NOT used for writes.
SUPABASE_PUBLISHABLE_KEY=
# REQUIRED for writes (session-pooler URI). Percent-encode any reserved
# characters in the password: @ : / ? # [ ] %
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------
# WEEKLY sync configuration (npm run sync)
# ---------------------------------------------------------------------------
STORES=Peckers Hitchin,Peckers Stevenage
# How many complete Mon-Sun weeks to pull when START_DATE/END_DATE are unset.
WEEKS_BACK=4
# Explicit week-window override for the WEEKLY sync only.
START_DATE=
END_DATE=

# ---------------------------------------------------------------------------
# DAILY net-sales sync (npm run sync:daily) — see docs/daily-net-sales.md
# ---------------------------------------------------------------------------
# How many days back from yesterday to re-pull each run. Default 3.
# Not a backfill: delivery-platform figures can settle after midnight, and the
# load is idempotent per (store, date), so re-pulling D-1/D-2/D-3 lets late
# corrections self-heal and repairs any night the cron missed.
DAILY_LOOKBACK_DAYS=3

# Manual re-run of a specific inclusive date range (YYYY-MM-DD). Both or neither.
#
# Deliberately NOT named START_DATE/END_DATE: those belong to the weekly sync
# and are usually pinned to some past WEEK. A `npm run sync:daily` that
# inherited them would re-pull that old window into the daily table instead of
# yesterday.
DAILY_START_DATE=
DAILY_END_DATE=

# ---------------------------------------------------------------------------
# Timezone
# ---------------------------------------------------------------------------
# Affects local-time LOGGING only. The weekly Mon-Sun maths is done in UTC for
# determinism; the daily sync computes "yesterday" in Europe/London because a
# business date is a local trading-day concept. Neither reads this value.
TZ=Europe/London

# ---------------------------------------------------------------------------
# Browser behaviour
# ---------------------------------------------------------------------------
# 1 = headless (required in CI), 0 = show the browser
HEADLESS=1
# 1 = save debug screenshots to debug/
DEBUG_SHOTS=0

# ---------------------------------------------------------------------------
# Sauce Management API (GET /api/sauce/daily-net-sales, /api/sauce/health)
# ---------------------------------------------------------------------------
# Bearer token the teammate's app sends as `Authorization: Bearer <this>`.
# Generate with: openssl rand -hex 32
SAUCE_API_KEY=

# ---------------------------------------------------------------------------
# Nightly trigger (POST /api/internal/trigger-daily-sync) — cron-job.org
# ---------------------------------------------------------------------------
# A SECOND, DIFFERENT token from SAUCE_API_KEY. Held by cron-job.org only.
# Generate with: openssl rand -hex 32
#
# Kept separate on purpose: SAUCE_API_KEY only reads sales figures, this one can
# start a VM Hub scrape. One shared token would let the teammate kick off
# scrapes, and rotating their key would silently kill the nightly cron.
DAILY_SYNC_TRIGGER_SECRET=

# Hard kill for a wedged run, in milliseconds. Default 1200000 (20 minutes),
# matching the old workflow's timeout-minutes. Do NOT raise it without moving
# the cron-job.org schedule earlier: the daily run must be finished before the
# weekly sync starts at 01:30 UTC, or the two fight over the VM Hub session.
DAILY_SYNC_TIMEOUT_MS=1200000

# ---------------------------------------------------------------------------
# Hosting (npm run api-start)
# ---------------------------------------------------------------------------
API_PORT=3000
# 0.0.0.0 is required inside a container; leave unset locally.
API_HOST=

# Set to 1 on ANY internet-facing host. Serves only the bearer-authenticated
# /api/sauce/* and /api/internal/* routes.
#
# Leaving it unset in public also serves /api/stores, /api/weeks and
# /api/kpis/* — which have no authentication at all and send
# Access-Control-Allow-Origin: * — so every store's revenue, margin and labour
# KPIs would be readable by anyone who finds the hostname.
PUBLIC_DEPLOY=

# ===========================================================================
# GitHub Actions SECRETS (not read from this file — set them in repo settings)
# ===========================================================================
# These belong to the WEEKLY sync (.github/workflows/sync.yml) only.
# The DAILY sync no longer uses GitHub Actions — it runs on the host that
# serves this API, started by cron-job.org. See docs/daily-net-sales.md.
#
#   VM_HUB_EMAIL, VM_HUB_PASSWORD, SUPABASE_DB_URL
#   VM_AUTH_JSON     — saved Playwright storageState (output of `npm run auth`)
